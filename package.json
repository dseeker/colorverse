{
  "name": "colorverse",
  "version": "1.0.0",
  "description": "Free Personalized Coloring Pages",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "serve -l 4000",
    "dev": "serve -l 4000",
    "build": "node scripts/build.js",
    "build:text": "node scripts/build.js --text-only",
    "build:images": "node scripts/build.js --images-only",
    "build:quick": "node scripts/build.js --categories 3",
    "build:package": "node scripts/build.js --package-only",
    "serve:dist": "serve dist -l 4000",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:workers": "vitest run workers/",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:dist": "playwright test --config playwright.dist.config.ts",
    "test:e2e:sw": "playwright test --config playwright.sw.config.ts",
    "test:e2e:playwright": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:json-structure": "vitest run tests/integration/json-structure-generator.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,jsx,tsx,json,css,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "coloring",
    "pages",
    "pollinations"
  ],
  "author": "dseeker",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^16.0.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.0",
    "prettier": "^3.7.4",
    "serve": "^14.2.4",
    "vitest": "^4.0.16"
  }
}
